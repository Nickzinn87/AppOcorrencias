<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppOcorrencias.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppOcorrencias"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    Title="AppOcorrencias">

    <ShellContent
        Route="splash"
        ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent
        Route="sync"
        ContentTemplate="{DataTemplate views:pgSincronizar}" />
    <ShellContent
        Route="nova"
        ContentTemplate="{DataTemplate views:pgNovaOcorrencia}" />

</Shell>
