<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgOcorrenciaPasso1"
    BackgroundColor="#4850A3">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="2" Margin="0,10,0,0">
                <Label Text="Nova Ocorrência" TextColor="White" FontSize="26" FontAttributes="Bold"/>
                <Label Text="Passo 1 de 5 — Dados da Ocorrência" TextColor="#D9DBF5" FontSize="13"/>
            </VerticalStackLayout>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">

                    <Label Text="N°" FontSize="13" FontAttributes="Bold" TextColor="#767DCA"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding Numero}" Placeholder="Número do registro" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Natureza da Ocorrência" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,14,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding Natureza}" Placeholder="Ex: Evasão escolar, Maus tratos..." PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Local" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,14,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding Local}" Placeholder="Local da ocorrência" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Data" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,14,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <DatePicker Date="{Binding Data}" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Hora" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,14,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding Hora}" Placeholder="Ex: 14h30min" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Solicitante" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,14,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding Solicitante}" Placeholder="Quem solicitou" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Próximo →"
                Command="{Binding ProximoCommand}"
                BackgroundColor="#767DCA"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="52"
                Margin="0,4,0,24"/>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>