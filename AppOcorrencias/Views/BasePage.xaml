<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppOcorrencias.Views.BasePage">

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <!-- CONTEÚDO PRINCIPAL -->
                <Grid RowDefinitions="Auto,*">

                    <!-- HEADER -->
                    <Grid
                        ZIndex="3"
                        HeightRequest="60"
                        BackgroundColor="#767DCA"
                        Padding="10"
                        ColumnDefinitions="Auto,*,Auto">

                        <ImageButton
                        Source="menu.png"
                        WidthRequest="30"
                        BackgroundColor="Transparent"
                        Command="{TemplateBinding BindingContext.ToggleMenuCommand}"/>

                        <Label
                        Grid.Column="1"
                        Text="Alexandre Rodrigues Filho"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                    </Grid>

                    <!-- CONTEÚDO DA PÁGINA -->
                    <ContentPresenter Grid.Row="1"/>

                </Grid>

                <!-- OVERLAY -->
                <Grid
                    ZIndex="1"
                    Margin="0, 60, 0, 0"
                    IsVisible="{TemplateBinding BindingContext.MenuAberto}"
                    BackgroundColor="#80000000">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                        Command="{TemplateBinding BindingContext.ToggleMenuCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- MENU LATERAL -->
                <Grid
                    ZIndex="2"
                    WidthRequest="100"
                    BackgroundColor="#767DCA"
                    HorizontalOptions="Start"
                    Margin="0, 60, 0, 0"
                    IsVisible="{TemplateBinding BindingContext.MenuAberto}">

                    <VerticalStackLayout Padding="20">
                        <Label Text="Menu" TextColor="White" FontSize="18"/>
                        <ImageButton
                            Source="home.png"
                            Margin="0, 15, 0, 15"
                            WidthRequest="30"
                            BackgroundColor="Transparent"
                            Command="{TemplateBinding BindingContext.ToggleMenuCommand}"/>

                        <ImageButton
                            Source="nova.png"
                            Margin="0, 15, 0, 15"
                            WidthRequest="30"
                            BackgroundColor="Transparent"
                            Command="{TemplateBinding BindingContext.OpenNova}"/>

                        <ImageButton
                            Source="meus.png"
                            Margin="0, 15, 0, 15"
                            WidthRequest="30"
                            BackgroundColor="Transparent"
                            Command="{TemplateBinding BindingContext.ToggleMenuCommand}"/>

                        <ImageButton
                            Source="sync.png"
                            Margin="0, 15, 0, 15"
                            WidthRequest="30"
                            BackgroundColor="Transparent"
                            Command="{TemplateBinding BindingContext.OpenSync}"/>
                    </VerticalStackLayout>

                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

</ContentPage>