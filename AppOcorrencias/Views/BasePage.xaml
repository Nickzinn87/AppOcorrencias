<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppOcorrencias.Views.BasePage">

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <!-- CONTEÚDO PRINCIPAL -->
                <Grid RowDefinitions="Auto,*">

                    <!-- HEADER -->
                    <Grid
                    HeightRequest="60"
                    BackgroundColor="#121212"
                    Padding="10"
                    ColumnDefinitions="Auto,*,Auto">

                        <ImageButton
                        Source="menu.png"
                        WidthRequest="30"
                        BackgroundColor="Transparent"
                        Command="{TemplateBinding BindingContext.ToggleMenuCommand}"/>

                        <Label
                        Grid.Column="1"
                        Text="Estacione Legal"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                    </Grid>

                    <!-- CONTEÚDO DA PÁGINA -->
                    <ContentPresenter Grid.Row="1"/>

                </Grid>

                <!-- OVERLAY -->
                <Grid
                IsVisible="{TemplateBinding BindingContext.MenuAberto}"
                BackgroundColor="#80000000">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                        Command="{TemplateBinding BindingContext.ToggleMenuCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- MENU LATERAL -->
                <Grid
                WidthRequest="260"
                BackgroundColor="#1E1E1E"
                HorizontalOptions="Start"
                IsVisible="{TemplateBinding BindingContext.MenuAberto}">

                    <VerticalStackLayout Padding="20">
                        <Label Text="Menu" TextColor="White" FontSize="18"/>
                        <Button Text="Nova Ocorrência"/>
                        <Button Text="Outra Página"/>
                    </VerticalStackLayout>

                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

</ContentPage>