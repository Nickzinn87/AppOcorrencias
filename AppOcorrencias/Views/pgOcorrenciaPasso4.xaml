<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgOcorrenciaPasso4">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0D26" Offset="0.0"/>
            <GradientStop Color="#161B45" Offset="0.5"/>
            <GradientStop Color="#0B0D26" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="2" Margin="0,10,0,0">
                <Label
                    Text="NOVA OCORRÊNCIA"
                    TextColor="#8B92C9"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"/>
                <Label Text="Endereços" TextColor="White" FontSize="24" FontAttributes="Bold"/>

                <!-- INDICADOR DE PROGRESSO -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="4" HeightRequest="4" CornerRadius="2" BackgroundColor="#2A2F5C"/>
                </Grid>
                <Label Text="Passo 4 de 5" TextColor="#5C639C" FontSize="12" Margin="0,4,0,0"/>
            </VerticalStackLayout>

            <!-- CARD: ENDEREÇO RESIDENCIAL -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Endereço Residencial" TextColor="White" FontAttributes="Bold" FontSize="17" Margin="0,0,0,6"/>

                    <Label Text="Endereço" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding EnderecoResidencial}" Placeholder="Rua, avenida..." PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="N°" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding EnderecoResidencialNumero}" Placeholder="N°" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Keyboard="Numeric"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Bairro" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding BairroResidencial}" Placeholder="Bairro" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Complemento" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding ComplementoResidencial}" Placeholder="Complemento" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Fone" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding FoneResidencial}" Placeholder="Telefone" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Keyboard="Telephone"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD: ENDEREÇO COMERCIAL -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Endereço Comercial" TextColor="White" FontAttributes="Bold" FontSize="17" Margin="0,0,0,6"/>

                    <Label Text="Endereço" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding EnderecoComercial}" Placeholder="Rua, avenida..." PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="N°" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding EnderecoComercialNumero}" Placeholder="N°" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Keyboard="Numeric"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Bairro" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding BairroComercial}" Placeholder="Bairro" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Complemento" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding ComplementoComercial}" Placeholder="Complemento" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Fone" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding FoneComercial}" Placeholder="Telefone" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Keyboard="Telephone"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,24">
                <Border StrokeShape="RoundRectangle 12" Stroke="#2A2F5C" StrokeThickness="1" BackgroundColor="#141833" HeightRequest="52">
                    <Button
                        Text="← Voltar"
                        Command="{Binding VoltarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="52">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8B5CF6" Offset="0.0"/>
                            <GradientStop Color="#3B82F6" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button
                        Text="Próximo →"
                        Command="{Binding ProximoCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>