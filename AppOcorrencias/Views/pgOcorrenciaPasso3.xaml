<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgOcorrenciaPasso3"
    BackgroundColor="#4850A3">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="2" Margin="0,10,0,0">
                <Label Text="Nova Ocorrência" TextColor="White" FontSize="26" FontAttributes="Bold"/>
                <Label Text="Passo 3 de 5 — Filiação / Responsável" TextColor="#D9DBF5" FontSize="13"/>
            </VerticalStackLayout>

            <!-- CARD: MÃE -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Mãe" TextColor="#4850A3" FontAttributes="Bold" FontSize="18" Margin="0,0,0,6"/>

                    <Label Text="Nome" FontSize="13" FontAttributes="Bold" TextColor="#767DCA"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding MaeNome}" Placeholder="Nome da mãe" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="R.G." FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding MaeRG}" Placeholder="RG da mãe" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="C.P.F." FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding MaeCPF}" Placeholder="CPF da mãe" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Profissão" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding MaeProfissao}" Placeholder="Profissão da mãe" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD: PAI -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Pai" TextColor="#4850A3" FontAttributes="Bold" FontSize="18" Margin="0,0,0,6"/>

                    <Label Text="Nome" FontSize="13" FontAttributes="Bold" TextColor="#767DCA"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding PaiNome}" Placeholder="Nome do pai" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="R.G." FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding PaiRG}" Placeholder="RG do pai" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="C.P.F." FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding PaiCPF}" Placeholder="CPF do pai" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Profissão" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding PaiProfissao}" Placeholder="Profissão do pai" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD: RESPONSÁVEL -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Responsável (se aplicável)" TextColor="#4850A3" FontAttributes="Bold" FontSize="18" Margin="0,0,0,6"/>

                    <Label Text="Nome" FontSize="13" FontAttributes="Bold" TextColor="#767DCA"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding ResponsavelNome}" Placeholder="Nome do responsável" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="R.G." FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding ResponsavelRG}" Placeholder="RG do responsável" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Profissão" FontSize="13" FontAttributes="Bold" TextColor="#767DCA" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding ResponsavelProfissao}" Placeholder="Profissão do responsável" PlaceholderColor="#B7B9E0" TextColor="#2B2E4A" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,24">
                <Button
                    Grid.Column="0"
                    Text="← Voltar"
                    Command="{Binding VoltarCommand}"
                    BackgroundColor="#3A4088"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"/>
                <Button
                    Grid.Column="1"
                    Text="Próximo →"
                    Command="{Binding ProximoCommand}"
                    BackgroundColor="#767DCA"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>