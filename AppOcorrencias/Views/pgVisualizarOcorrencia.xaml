<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgVisualizarOcorrencia"
    BackgroundColor="#4850A3">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Detalhes da Ocorrência" TextColor="White" FontSize="24" FontAttributes="Bold"/>
                    <Label Text="{Binding Ocorrencia.Natureza}" TextColor="#D9DBF5" FontSize="14"/>
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    VerticalOptions="Center"
                    BackgroundColor="{Binding StatusCor}"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    Padding="12,6">
                    <Label Text="{Binding StatusTexto}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                </Border>
            </Grid>

            <!-- DADOS DA OCORRÊNCIA -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Dados da Ocorrência" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="N°" FontSize="12" TextColor="#767DCA" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Numero}" FontSize="15" TextColor="#2B2E4A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Local" FontSize="12" TextColor="#767DCA" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Local}" FontSize="15" TextColor="#2B2E4A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Data / Hora" FontSize="12" TextColor="#767DCA" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Data, StringFormat='{0:dd/MM/yyyy}'}" FontSize="15" TextColor="#2B2E4A"/>
                        <Label Text="{Binding Ocorrencia.Hora}" FontSize="15" TextColor="#2B2E4A"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Solicitante" FontSize="12" TextColor="#767DCA" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Solicitante}" FontSize="15" TextColor="#2B2E4A"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ADOLESCENTES -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Adolescente(s)" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>

                    <CollectionView ItemsSource="{Binding Adolescentes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#E4E5F5"
                                    StrokeThickness="1"
                                    BackgroundColor="#F5F6FC"
                                    Padding="12"
                                    Margin="0,4">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Nome}" TextColor="#2B2E4A" FontAttributes="Bold"/>
                                        <Label Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" TextColor="#767DCA" FontSize="12"/>
                                        <Label Text="{Binding Escola, StringFormat='Escola: {0}'}" TextColor="#767DCA" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- MÃE -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20" IsVisible="{Binding TemMae}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Mãe" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.MaeNome}" TextColor="#2B2E4A" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.MaeRG, StringFormat='RG: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.MaeCPF, StringFormat='CPF: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.MaeProfissao, StringFormat='Profissão: {0}'}" TextColor="#767DCA" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- PAI -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20" IsVisible="{Binding TemPai}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Pai" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.PaiNome}" TextColor="#2B2E4A" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.PaiRG, StringFormat='RG: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.PaiCPF, StringFormat='CPF: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.PaiProfissao, StringFormat='Profissão: {0}'}" TextColor="#767DCA" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- RESPONSÁVEL -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20" IsVisible="{Binding TemResponsavel}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Responsável" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelNome}" TextColor="#2B2E4A" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelRG, StringFormat='RG: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelProfissao, StringFormat='Profissão: {0}'}" TextColor="#767DCA" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- ENDEREÇOS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Endereço Residencial" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.EnderecoResidencial}" TextColor="#2B2E4A" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.BairroResidencial, StringFormat='Bairro: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.FoneResidencial, StringFormat='Fone: {0}'}" TextColor="#767DCA" FontSize="13"/>

                    <BoxView HeightRequest="1" Color="#E4E5F5" Margin="0,10" IsVisible="{Binding TemEnderecoComercial}"/>

                    <VerticalStackLayout IsVisible="{Binding TemEnderecoComercial}" Spacing="6">
                        <Label Text="Endereço Comercial" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>
                        <Label Text="{Binding Ocorrencia.EnderecoComercial}" TextColor="#2B2E4A" FontSize="15"/>
                        <Label Text="{Binding Ocorrencia.BairroComercial, StringFormat='Bairro: {0}'}" TextColor="#767DCA" FontSize="13"/>
                        <Label Text="{Binding Ocorrencia.FoneComercial, StringFormat='Fone: {0}'}" TextColor="#767DCA" FontSize="13"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- HISTÓRICO -->
            <!-- HISTÓRICO -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Histórico" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>

                    <Border StrokeShape="RoundRectangle 10" Stroke="#DADCF0" StrokeThickness="1.5" Padding="12,8">
                        <Editor
                Text="{Binding HistoricoEditavel}"
                Placeholder="Descreva o histórico da ocorrência"
                PlaceholderColor="#B7B9E0"
                TextColor="#2B2E4A"
                BackgroundColor="Transparent"
                AutoSize="TextChanges"
                HeightRequest="150"/>
                    </Border>

                    <Button
            Text="Salvar Histórico"
            Command="{Binding SalvarHistoricoCommand}"
            BackgroundColor="#767DCA"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="10"
            HeightRequest="44"/>
                </VerticalStackLayout>
            </Border>

            <!-- ASSINATURAS -->
            <!-- ASSINATURAS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" Stroke="Transparent" Padding="20" Margin="0,0,0,24">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Assinaturas" TextColor="#4850A3" FontAttributes="Bold" FontSize="17"/>

                    <CollectionView ItemsSource="{Binding Assinantes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E4E5F5"
                        StrokeThickness="1"
                        BackgroundColor="#F5F6FC"
                        Padding="12"
                        Margin="0,4">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <Border
                                Grid.Column="0"
                                IsVisible="{Binding Assinado}"
                                WidthRequest="60"
                                HeightRequest="60"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#DADCF0"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="3">
                                            <Image Source="{Binding AssinaturaPreview}" Aspect="AspectFit"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Papel}" TextColor="#2B2E4A" FontAttributes="Bold"/>
                                            <Label Text="{Binding Assinado, StringFormat='Assinado: {0}'}" TextColor="#767DCA" FontSize="12"/>
                                        </VerticalStackLayout>

                                        <Button
    Grid.Column="2"
    Text="Assinar"
    VerticalOptions="Center"
    BackgroundColor="#4850A3"
    TextColor="White"
    CornerRadius="8"
    FontSize="13"
    HeightRequest="38"
    Command="{Binding Source={RelativeSource AncestorType={x:Type views:pgVisualizarOcorrencia}}, Path=BindingContext.AssinarCommand}"
    CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>