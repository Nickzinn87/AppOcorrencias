<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgVisualizarOcorrencia">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0D26" Offset="0.0"/>
            <GradientStop Color="#161B45" Offset="0.5"/>
            <GradientStop Color="#0B0D26" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Cabecalho -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label
                        Text="DETALHES DA OCORRÊNCIA"
                        TextColor="#8B92C9"
                        FontSize="11"
                        CharacterSpacing="2"
                        FontAttributes="Bold"/>
                    <Label Text="{Binding Ocorrencia.Natureza}" TextColor="White" FontSize="22" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    VerticalOptions="Center"
                    BackgroundColor="{Binding StatusCor}"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    Padding="12,6">
                    <Label Text="{Binding StatusTexto}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                </Border>
            </Grid>

            <!-- Dados da ocorrencia -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Dados da Ocorrência" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="N°" FontSize="12" CharacterSpacing="1" TextColor="#8B92C9" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Numero}" FontSize="15" TextColor="White"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Local" FontSize="12" CharacterSpacing="1" TextColor="#8B92C9" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Local}" FontSize="15" TextColor="White"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Data / Hora" FontSize="12" CharacterSpacing="1" TextColor="#8B92C9" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Data, StringFormat='{0:dd/MM/yyyy}'}" FontSize="15" TextColor="White"/>
                        <Label Text="{Binding Ocorrencia.Hora}" FontSize="15" TextColor="White"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Solicitante" FontSize="12" CharacterSpacing="1" TextColor="#8B92C9" FontAttributes="Bold"/>
                        <Label Text="{Binding Ocorrencia.Solicitante}" FontSize="15" TextColor="White"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Adolescentes -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Adolescente(s)" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <CollectionView ItemsSource="{Binding Adolescentes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2F5C"
                                    StrokeThickness="1"
                                    BackgroundColor="#0F1330"
                                    Padding="12"
                                    Margin="0,4">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Nome}" TextColor="White" FontAttributes="Bold"/>
                                        <Label Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" TextColor="#8B92C9" FontSize="12"/>
                                        <Label Text="{Binding Escola, StringFormat='Escola: {0}'}" TextColor="#8B92C9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Mae -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20" IsVisible="{Binding TemMae}">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Mãe" TextColor="White" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.MaeNome}" TextColor="White" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.MaeRG, StringFormat='RG: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.MaeCPF, StringFormat='CPF: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.MaeProfissao, StringFormat='Profissão: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- Pai -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20" IsVisible="{Binding TemPai}">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Pai" TextColor="White" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.PaiNome}" TextColor="White" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.PaiRG, StringFormat='RG: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.PaiCPF, StringFormat='CPF: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.PaiProfissao, StringFormat='Profissão: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- Responsavel -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20" IsVisible="{Binding TemResponsavel}">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Responsável" TextColor="White" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelNome}" TextColor="White" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelRG, StringFormat='RG: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.ResponsavelProfissao, StringFormat='Profissão: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- Enderecos -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Endereço Residencial" TextColor="White" FontAttributes="Bold" FontSize="17"/>
                    <Label Text="{Binding Ocorrencia.EnderecoResidencial}" TextColor="White" FontSize="15"/>
                    <Label Text="{Binding Ocorrencia.BairroResidencial, StringFormat='Bairro: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    <Label Text="{Binding Ocorrencia.FoneResidencial, StringFormat='Fone: {0}'}" TextColor="#8B92C9" FontSize="13"/>

                    <BoxView HeightRequest="1" Color="#2A2F5C" Margin="0,10" IsVisible="{Binding TemEnderecoComercial}"/>

                    <VerticalStackLayout IsVisible="{Binding TemEnderecoComercial}" Spacing="6">
                        <Label Text="Endereço Comercial" TextColor="White" FontAttributes="Bold" FontSize="17"/>
                        <Label Text="{Binding Ocorrencia.EnderecoComercial}" TextColor="White" FontSize="15"/>
                        <Label Text="{Binding Ocorrencia.BairroComercial, StringFormat='Bairro: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                        <Label Text="{Binding Ocorrencia.FoneComercial, StringFormat='Fone: {0}'}" TextColor="#8B92C9" FontSize="13"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Historico -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Histórico" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,8">
                        <Editor
                            Text="{Binding HistoricoEditavel}"
                            Placeholder="Descreva o histórico da ocorrência"
                            PlaceholderColor="#4C5389"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            HeightRequest="150"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" HeightRequest="44">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                <GradientStop Color="#3B82F6" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Button
                            Text="Salvar Histórico"
                            Command="{Binding SalvarHistoricoCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontAttributes="Bold"
                            BorderWidth="0"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Assinaturas -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20" Margin="0,0,0,24">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Assinaturas" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <CollectionView ItemsSource="{Binding Assinantes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2F5C"
                                    StrokeThickness="1"
                                    BackgroundColor="#0F1330"
                                    Padding="12"
                                    Margin="0,4">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <Border
                                            Grid.Column="0"
                                            IsVisible="{Binding Assinado}"
                                            WidthRequest="60"
                                            HeightRequest="60"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="#2A2F5C"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            Padding="3">
                                            <Image Source="{Binding AssinaturaPreview}" Aspect="AspectFit"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Papel}" TextColor="White" FontAttributes="Bold"/>
                                            <Label Text="{Binding Assinado, StringFormat='Assinado: {0}'}" TextColor="#8B92C9" FontSize="12"/>
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            HeightRequest="38">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                                    <GradientStop Color="#3B82F6" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Button
                                                Text="Assinar"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                TextColor="White"
                                                FontSize="13"
                                                BorderWidth="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type views:pgVisualizarOcorrencia}}, Path=BindingContext.AssinarCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>