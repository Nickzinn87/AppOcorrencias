<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgOcorrenciaPasso5">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0D26" Offset="0.0"/>
            <GradientStop Color="#161B45" Offset="0.5"/>
            <GradientStop Color="#0B0D26" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="2" Margin="0,10,0,0">
                <Label
                    Text="NOVA OCORRÊNCIA"
                    TextColor="#8B92C9"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"/>
                <Label Text="Histórico e Assinaturas" TextColor="White" FontSize="24" FontAttributes="Bold"/>

                <!-- INDICADOR DE PROGRESSO -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="4" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                </Grid>
                <Label Text="Passo 5 de 5" TextColor="#5C639C" FontSize="12" Margin="0,4,0,0"/>
            </VerticalStackLayout>

            <!-- CARD: HISTÓRICO -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Histórico" TextColor="White" FontAttributes="Bold" FontSize="17" Margin="0,0,0,6"/>

                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,8">
                        <Editor
                            Text="{Binding Historico}"
                            Placeholder="Descreva o histórico da ocorrência"
                            PlaceholderColor="#4C5389"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            HeightRequest="180"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD: ASSINATURAS -->
            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Assinaturas" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <CollectionView ItemsSource="{Binding Assinantes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2F5C"
                                    StrokeThickness="1"
                                    BackgroundColor="#0F1330"
                                    Padding="12"
                                    Margin="0,4">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <Border
                                            Grid.Column="0"
                                            IsVisible="{Binding Assinado}"
                                            WidthRequest="64"
                                            HeightRequest="64"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="#2A2F5C"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            Padding="3">
                                            <Image Source="{Binding AssinaturaPreview}" Aspect="AspectFit"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Papel}" TextColor="White" FontAttributes="Bold"/>
                                            <Label
                                                Text="{Binding Assinado, StringFormat='Assinado: {0}'}"
                                                TextColor="#8B92C9"
                                                FontSize="12"/>
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            HeightRequest="38">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                                    <GradientStop Color="#3B82F6" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Button
                                                Text="Assinar"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                TextColor="White"
                                                FontSize="13"
                                                BorderWidth="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type views:pgOcorrenciaPasso5}}, Path=BindingContext.AssinarCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,24">
                <Border StrokeShape="RoundRectangle 12" Stroke="#2A2F5C" StrokeThickness="1" BackgroundColor="#141833" HeightRequest="52">
                    <Button
                        Text="← Voltar"
                        Command="{Binding VoltarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="52">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8B5CF6" Offset="0.0"/>
                            <GradientStop Color="#3B82F6" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button
                        Text="Concluir ✓"
                        Command="{Binding ConcluirCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>