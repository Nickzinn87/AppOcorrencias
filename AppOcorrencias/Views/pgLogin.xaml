<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppOcorrencias.Views.pgLogin"
             Title="pgLogin">
    <StackLayout HorizontalOptions="FillAndExpand" BackgroundColor="#4850A3" Padding="30, 75, 30, 0">

        <Label Text="GuardSystem"
               FontSize="Large"
               FontFamily="Arial"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,100"/>

        <StackLayout HorizontalOptions="FillAndExpand">

            <Label Text="CPF:" FontSize="Subtitle" Margin="0,30,0,0"/>
            <Entry Text="{Binding CPF}" />

            <Label Text="Senha:" FontSize="Subtitle" Margin="0,30,0,0"/>
            <Entry Text="{Binding Senha}" IsPassword="True"/>

            <Button Text="Entrar"
                    Command="{Binding LoginCommand}"
                    Margin="0, 50, 0, 0"
                    MaximumWidthRequest="150"/>
        </StackLayout>
    </StackLayout>
</ContentPage>