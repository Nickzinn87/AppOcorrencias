<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgMinhasOcorrencias">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0D26" Offset="0.0"/>
            <GradientStop Color="#161B45" Offset="0.5"/>
            <GradientStop Color="#0B0D26" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="0,10,0,16">
            <Label
                Text="MINHAS OCORRÊNCIAS"
                TextColor="#8B92C9"
                FontSize="11"
                CharacterSpacing="2"
                FontAttributes="Bold"/>
            <Label Text="Registros feitos por você" TextColor="White" FontSize="24" FontAttributes="Bold"/>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding AtualizarCommand}" IsRefreshing="{Binding Carregando}">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <!-- ESTADO VAZIO -->
                    <VerticalStackLayout IsVisible="{Binding SemOcorrencias}" Padding="0,60,0,0" Spacing="8">
                        <Label Text="📋" FontSize="42" HorizontalOptions="Center"/>
                        <Label
                            Text="Nenhuma ocorrência encontrada"
                            TextColor="#8B92C9"
                            FontSize="15"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- LISTA -->
                    <CollectionView ItemsSource="{Binding Ocorrencias}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="#141833"
                                    Stroke="#2A2F5C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,4">

                                    <Border.Shadow>
                                        <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                                    </Border.Shadow>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:pgMinhasOcorrencias}}, Path=BindingContext.AbrirDetalhesCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                        <Label
                                            Grid.Row="0" Grid.Column="0"
                                            Text="{Binding Natureza}"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="16"/>

                                        <Border
                                            Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding StatusCor}"
                                            StrokeShape="RoundRectangle 20"
                                            Stroke="Transparent"
                                            Padding="10,4">
                                            <Label
                                                Text="{Binding Status}"
                                                TextColor="White"
                                                FontSize="11"
                                                FontAttributes="Bold"/>
                                        </Border>

                                        <Label
                                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="{Binding Local}"
                                            TextColor="#A8AEDC"
                                            FontSize="13"/>

                                        <Label
                                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}"
                                            TextColor="#5C639C"
                                            FontSize="12"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>
</views:BasePage>