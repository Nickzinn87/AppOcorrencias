<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppOcorrencias.Views"
    x:Class="AppOcorrencias.Views.pgOcorrenciaPasso2">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0D26" Offset="0.0"/>
            <GradientStop Color="#161B45" Offset="0.5"/>
            <GradientStop Color="#0B0D26" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="2" Margin="0,10,0,0">
                <Label
                    Text="NOVA OCORRÊNCIA"
                    TextColor="#8B92C9"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"/>
                <Label Text="Adolescente(s)" TextColor="White" FontSize="24" FontAttributes="Bold"/>

                <!-- INDICADOR DE PROGRESSO -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" BackgroundColor="#8B5CF6"/>
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" BackgroundColor="#2A2F5C"/>
                    <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" BackgroundColor="#2A2F5C"/>
                    <BoxView Grid.Column="4" HeightRequest="4" CornerRadius="2" BackgroundColor="#2A2F5C"/>
                </Grid>
                <Label Text="Passo 2 de 5" TextColor="#5C639C" FontSize="12" Margin="0,4,0,0"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#141833" Stroke="#2A2F5C" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#5B6EF5" Offset="0,4" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Label Text="Adolescente(s)" TextColor="White" FontAttributes="Bold" FontSize="17"/>

                    <Label Text="Nome" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding NovoNome}" Placeholder="Nome do adolescente" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Data de Nascimento" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <DatePicker Date="{Binding NovaDataNascimento}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Escola" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#8B92C9" Margin="0,10,0,0"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2F5C" StrokeThickness="1.5" BackgroundColor="#0F1330" Padding="12,0" HeightRequest="46">
                        <Entry Text="{Binding NovaEscola}" Placeholder="Escola do adolescente" PlaceholderColor="#4C5389" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" Margin="0,10,0,0" HeightRequest="44">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                <GradientStop Color="#3B82F6" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Button
                            Text="Adicionar Adolescente"
                            Command="{Binding AdicionarAdolescenteCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontAttributes="Bold"
                            BorderWidth="0"/>
                    </Border>

                    <CollectionView ItemsSource="{Binding Adolescentes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2F5C"
                                    StrokeThickness="1"
                                    BackgroundColor="#0F1330"
                                    Padding="12"
                                    Margin="0,4">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding Nome}" TextColor="White" FontAttributes="Bold"/>
                                            <Label Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" TextColor="#8B92C9" FontSize="12"/>
                                            <Label Text="{Binding Escola, StringFormat='Escola: {0}'}" TextColor="#8B92C9" FontSize="12"/>
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="1"
                                            Text="Remover"
                                            VerticalOptions="Center"
                                            BackgroundColor="#2A1420"
                                            BorderColor="#5C2A3A"
                                            BorderWidth="1"
                                            TextColor="#F28B9C"
                                            CornerRadius="8"
                                            FontSize="13"
                                            HeightRequest="38"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:pgOcorrenciaPasso2}}, Path=BindingContext.RemoverAdolescenteCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,24">
                <Border StrokeShape="RoundRectangle 12" Stroke="#2A2F5C" StrokeThickness="1" BackgroundColor="#141833" HeightRequest="52">
                    <Button
                        Text="← Voltar"
                        Command="{Binding VoltarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="52">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8B5CF6" Offset="0.0"/>
                            <GradientStop Color="#3B82F6" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button
                        Text="Próximo →"
                        Command="{Binding ProximoCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        BorderWidth="0"/>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>